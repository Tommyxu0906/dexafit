NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin submission notifications (optional) ---------------------------
# Without these the app runs normally; applications are still received and
# queued, only the notification email is skipped (and the reason is logged).

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Comma-separated. Everyone here is emailed when a professional submits.
ADMIN_NOTIFICATION_EMAILS=

# Defaults to Resend's shared domain, which only delivers to the address that
# owns the Resend account. Point this at a verified DexaFit domain before
# notifying anyone else.
# EMAIL_FROM=DexaFit Onboarding <onboarding@dexafit.com>

# Reply-to on provider emails. Defaults to the first admin address above.
# SUPPORT_EMAIL=support@dexafit.com

# Base URL for links in outbound email. Optional locally (defaults to
# localhost:3000); REQUIRED in production, where a missing or localhost value is
# refused rather than emitting links nobody can click.
# APP_URL=https://app.dexafit.com

# --- Error monitoring (optional) -----------------------------------------
# Server-side errors are always logged as structured JSON with an event id.
# Setting a Sentry DSN additionally forwards them. The app runs normally
# without it.
# SENTRY_DSN=
